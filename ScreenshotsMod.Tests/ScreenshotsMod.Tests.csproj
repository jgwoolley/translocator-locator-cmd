<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <VINTAGE_STORY>$(MSBuildProjectDirectory)/../vintagestory</VINTAGE_STORY>
        <RootNamespace>Nf3t.VintageStory.Screenshots.Tests</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
        </Reference>
        <!-- Only the game-independent parts are compiled in. -->
        <Compile Include="..\ScreenshotsMod\ScreenshotRecord.cs" LinkBase="Mod"/>
        <Compile Include="..\ScreenshotsMod\ScreenshotIndex.cs" LinkBase="Mod"/>
        <Compile Include="..\ScreenshotsMod\ScreenshotText.cs" LinkBase="Mod"/>
        <Compile Include="..\ScreenshotsMod\ExifReader.cs" LinkBase="Mod"/>
        <Compile Include="..\ScreenshotsMod\ScreenshotImport.cs" LinkBase="Mod"/>
        <Compile Include="..\ScreenshotsMod\NavigatorCompatibility.cs" LinkBase="Mod"/>
    </ItemGroup>

</Project>
